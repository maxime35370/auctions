// =============================================================================
// Auction Intelligence — Schéma de base de données
// =============================================================================
// SQLite pour le développement local. Migration vers PostgreSQL :
//   1. changer `provider` en "postgresql"
//   2. adapter DATABASE_URL dans .env
//   3. lancer `npx prisma migrate dev`
// Aucun type spécifique à SQLite n'est utilisé afin de garantir cette portabilité.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// AUCTION — Une enchère analysée (cœur de la V1)
// -----------------------------------------------------------------------------
// Les champs calculés (totalCost, roi, score…) sont persistés en plus des
// entrées brutes : ils alimentent le dashboard et l'historique sans recalcul,
// et permettront plus tard de comparer les prédictions aux résultats réels.
model Auction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Saisie utilisateur ---
  sourceUrl    String? // URL de l'annonce (import automatique prévu en V-future)
  title        String
  category     String  @default("autre")
  auctionHouse String? // maison de vente
  location     String?
  currentPrice Float // prix actuel (prix marteau envisagé)
  buyerFeePct  Float   @default(0) // frais acheteur en %
  vatPct       Float   @default(0) // TVA en % (appliquée sur prix + frais)
  travelCost   Float   @default(0) // coût estimé du déplacement
  shippingCost Float   @default(0) // coût de livraison
  condition    String  @default("bon") // neuf | tres-bon | bon | moyen | a-reparer | epave
  refurbHours  Float   @default(0) // temps de remise en état estimé (heures)
  comments     String?

  // --- Estimation de revente (3 scénarios) ---
  resaleFast      Float @default(0) // revente rapide
  resaleNormal    Float @default(0) // revente normale
  resaleOptimized Float @default(0) // revente optimisée

  // --- Résultats calculés (snapshot du moteur src/lib/engine) ---
  totalCost       Float @default(0) // coût total réel
  maxBudget       Float @default(0) // budget maximal conseillé (prix marteau)
  potentialMargin Float @default(0) // marge potentielle (scénario normal)
  netProfit       Float @default(0) // bénéfice net (scénario normal)
  roi             Float @default(0) // ROI en %
  score           Int   @default(0) // score global /100
  scoreBreakdown  String  @default("{}") // détail des critères, JSON sérialisé (portable SQLite/PostgreSQL)

  // --- Cycle de vie ---
  status     String    @default("analysee") // analysee | suivie | achetee | perdue | revendue
  finalPrice Float? // prix d'adjudication réel (si connu)
  soldPrice  Float? // prix de revente réel (si revendu)
  soldAt     DateTime?

  // --- Lien vers la base de connaissances (V2) ---
  item   Item?   @relation(fields: [itemId], references: [id])
  itemId String?
}

// -----------------------------------------------------------------------------
// ITEM — Fiche objet de la base de connaissances (fondation V2)
// -----------------------------------------------------------------------------
// Exemple : "Canon EF 100-400 L II". Chaque enchère peut être rattachée à une
// fiche ; l'historique des enchères d'un même objet construira les statistiques
// de prix et l'« intelligence » de l'application.
model Item {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String
  brand    String?
  category String  @default("autre")

  priceNew          Float? // prix neuf
  priceUsed         Float? // prix occasion
  priceAvgObserved  Float? // prix moyen observé
  priceMin          Float?
  priceMax          Float?
  priceAuctionMax   Float? // prix conseillé aux enchères
  resaleFast        Float?
  resaleNormal      Float?
  resalePremium     Float?
  avgSaleTimeDays   Float? // temps moyen de vente
  notes             String?
  usefulLinks       String? // JSON sérialisé : [{label, url}]
  spareParts        String? // pièces détachées (texte libre)
  checkPoints       String? // points à vérifier (texte libre, un par ligne)

  auctions Auction[]
}
